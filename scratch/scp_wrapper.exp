#!/usr/bin/expect -f
set password [lindex $argv 0]
set src [lindex $argv 1]
set dest [lindex $argv 2]
set host [lindex $argv 3]
set user [lindex $argv 4]
spawn scp -o StrictHostKeyChecking=no $src $user@$host:$dest
expect {
    "*assword:*" {
        send "$password\n"
        exp_continue
    }
    eof
}
