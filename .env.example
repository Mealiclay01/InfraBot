# InfraBot Configuration

# SSH Access to Proxmox Host
SSH_HOST=your.proxmox.host.or.ip
SSH_USERNAME=your_ssh_username
# Use either SSH_PASSWORD or SSH_PRIVATE_KEY (private key preferred)
SSH_PASSWORD=your_ssh_password
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Local AI Connections
OLLAMA_URL=http://host.docker.internal:11434

# N8N Integration 
N8N_WEBHOOK_URL=http://n8n.example.com/webhook/alert
